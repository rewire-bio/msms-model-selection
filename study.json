{
  "schema_version": 1,
  "title": "Formula-free MS/MS molecular shortlisting",
  "question": "Which model and baseline should be used for formula-free ms/ms molecular shortlisting, within the original measured scope?",
  "validation_fixture": false,
  "experiment": {
    "command": [
      "uv",
      "run",
      "--project",
      "companion",
      "--frozen",
      "python",
      "scripts/reanalyse.py",
      "--config",
      "{config}",
      "--output",
      "{output}"
    ],
    "inputs": [
      "scripts/reanalyse.py",
      "companion/scripts/fuse_scores.py",
      "companion/scripts/rank_stats.py",
      "companion/scripts/analyse.py",
      "companion/msms_shortlist/metrics.py",
      "companion/pyproject.toml",
      "companion/uv.lock",
      "configs/corrected-analysis.json",
      "protocol/amendments/2026-10-06-corrected-analysis.md",
      "evidence/corrected-analysis/input-manifest.json",
      "data/manifest.json"
    ],
    "outputs": [
      "results.json",
      "analysis",
      "comparison-metrics.csv",
      "comparison-contrasts.csv",
      "comparison-abstention.csv",
      "fusion-weight.json",
      "run-receipt.json",
      "execution.log"
    ],
    "results_file": "results.json"
  },
  "reproduction": {
    "command": [
      "make",
      "reproduce-corrected"
    ],
    "results_file": "results/reproduction/results.json",
    "paper_file": "results/reproduction-paper.pdf",
    "abs_tolerance": 1e-08,
    "rel_tolerance": 0
  },
  "budgets": {
    "experiment_seconds": 900,
    "reproduction_seconds": 900,
    "worker_seconds": 1800,
    "max_worker_calls": 30,
    "max_attempts": 2,
    "max_storage_mb": 4096
  },
  "paper": {
    "source": "paper/main.tex",
    "pdf": "paper/build/main.pdf"
  }
}
